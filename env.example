# Supabase inputs use a publishable or legacy anon key only.
# Never expose a service-role key, secret key, or TELEMETRY_HMAC_KEY in Vite.
# Source defaults to simulation. Select Supabase in dashboard source settings.
# Within Supabase, raw CAN batches are the default input mode.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Raw CAN mode signs in with Supabase Auth (email/password; create the user in the
# Supabase dashboard -> Authentication). Raw CAN is readable by signed-in users only.
#
# Device the car signs as (its x-htp-device header). Start session / End session
# use it, and the car's batches land in this device's running session.
VITE_TELEMETRY_DEVICE_ID=YOUR_DEVICE_ID

# Optional: pre-link the dashboard to a telemetry.sessions id (raw mode normally
# sets this when you start or pick a session; legacy Broadcast mode needs it).
# VITE_TELEMETRY_SESSION_ID=00000000-0000-4000-8000-000000000000

# Optional. Default 3500 ms. Raw mode compares against the accepted batch's
# database received_at, not the time historical data was fetched.
# VITE_TELEMETRY_STALE_MS=3500

# Browser reads are permitted by the SELECT RLS policy for `authenticated` on
# telemetry.can_batches / telemetry.sessions. Management/MCP access does not grant
# the browser access to rows. The telemetry schema must be an exposed API schema.
