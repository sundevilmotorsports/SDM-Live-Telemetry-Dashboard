# Supabase Realtime Broadcast. Publishable or legacy anon key only.
# Never put a service-role key, a secret key, or TELEMETRY_HMAC_KEY here.
# Vite only exposes variables prefixed with VITE_ to the browser.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_TELEMETRY_SESSION_ID=00000000-0000-4000-8000-000000000000

# Optional. Local receipt older than this is marked stale. Default 3500 ms,
# a bit over the ~1 Hz per-group broadcast cadence.
# VITE_TELEMETRY_STALE_MS=3500
